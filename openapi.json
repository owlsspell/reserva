    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "409": {
            "description": "Email already taken"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Register a new user",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Login user",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens rotated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Unauthenticated / Expired / Reused refresh token"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Refresh access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Logged out successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Logout and revoke refresh token family",
        "tags": [
          "auth"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "MeController_getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get current user profile",
        "tags": [
          "users"
        ]
      }
    },
    "/resources": {
      "get": {
        "operationId": "ResourcesController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "List resources with filters and cursor pagination",
        "tags": [
          "resources"
        ]
      },
      "post": {
        "operationId": "ResourcesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateResourceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resource created successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden (admin role required)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a resource (Admin only)",
        "tags": [
          "resources"
        ]
      }
    }
  },
  "info": {
    "title": "Reserva API",
    "description": "The Reserva booking API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "customer@reserva.dev"
          },
          "password": {
            "type": "string",
            "example": "StrongPassword123!"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "01900000-0000-0000-0000-000000000000"
          },
          "email": {
            "type": "string",
            "example": "customer@reserva.dev"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "role": {
            "type": "string",
            "example": "customer"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-03-01T10:00:00Z"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "createdAt"
        ]
      },
      "AuthTokensResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsIn..."
          },
          "refreshToken": {
            "type": "string",
            "example": "a3f8c... (refresh token)"
          },
          "expiresIn": {
            "type": "number",
            "example": 900
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          },
          "tokens": {
            "$ref": "#/components/schemas/AuthTokensResponseDto"
          }
        },
        "required": [
          "user",
          "tokens"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "customer@reserva.dev"
          },
          "password": {
            "type": "string",
            "example": "StrongPassword123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "random-refresh-token-hex"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "random-refresh-token-hex"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateResourceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Conference Room A",
            "description": "Name of the resource"
          },
          "description": {
            "type": "string",
            "example": "Spacious room with projector",
            "description": "Description"
          },
          "type": {
            "type": "string",
            "example": "room",
            "description": "Type of resource (room, desk, court)"
          },
          "capacity": {
            "type": "number",
            "example": 10,
            "description": "Capacity"
          },
          "city": {
            "type": "string",
            "example": "Kyiv",
            "description": "City"
          },
          "timezone": {
            "type": "string",
            "example": "Europe/Kyiv",
            "description": "IANA timezone"
          },
          "pricePerHour": {
            "type": "number",
            "example": 5000,
            "description": "Price per hour in minor units (cents)"
          }
        },
        "required": [
          "name",
          "description",
          "type",
          "capacity",
          "city",
          "timezone",
          "pricePerHour"
        ]
      }
    }
  }
}
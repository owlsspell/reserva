datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String         @map("password_hash")
  name         String
  role         String         @default("customer")
  createdAt    DateTime @default(now()) @map("created_at")
  tokens       RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  familyId   String    @map("family_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}


model Resource {
  id           String             @id @default(uuid())
  name         String
  description  String
  type         String
  capacity     Int
  city         String
  timezone     String
  pricePerHour Int                @map("price_per_hour")
  archivedAt   DateTime?          @map("archived_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  schedules    ResourceSchedule[]
  blackouts    ResourceBlackout[]

  @@map("resources")
}

model ResourceSchedule {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  weekday    Int
  opensAt    String   @map("opens_at")
  closesAt   String   @map("closes_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("resource_schedules")
}

model ResourceBlackout {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  reason     String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("resource_blackouts")
}

